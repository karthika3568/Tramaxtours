# ==============================================================================
# Wanderer South India - Backend Environment Configuration Example
# Copy this file to .env and customize with your local environment values
# ==============================================================================

# Application Settings
APP_NAME=WandererSouthIndia
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wanderersouthindia
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JSON Web Token (JWT) Configuration
JWT_SECRET=YOUR_SECURE_RANDOM_64_CHAR_SECRET_KEY_HERE
JWT_EXPIRATION=86400
JWT_ISSUER=WandererSouthIndiaAPI

# Media Library & File Upload Configuration (in bytes, 10485760 = 10MB)
MEDIA_MAX_FILE_SIZE=10485760

# Super Admin Account Configuration
ADMIN_NAME=Super Admin
ADMIN_EMAIL=mkarthika3568@gmail.com
ADMIN_PASSWORD=Admin@12345

# ------------------------------------------------------------------------------
# Outgoing Mail (SMTP) Configuration
# Used for customer tour tickets, vouchers, and internal admin notifications.
# ------------------------------------------------------------------------------
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none
MAIL_FROM_ADDRESS=bookings@wanderersouthindia.com
MAIL_FROM_NAME="Wanderer South India"

# ------------------------------------------------------------------------------
# SMTP Configuration Examples:
#
# 1. Local Dev with Mailpit (No Auth / No Encryption):
#    MAIL_HOST=127.0.0.1
#    MAIL_PORT=1025
#    MAIL_USERNAME=
#    MAIL_PASSWORD=
#    MAIL_ENCRYPTION=none
#
# 2. Custom Domain SMTP (cPanel / DirectAdmin / Postfix):
#    MAIL_HOST=mail.wanderersouthindia.com
#    MAIL_PORT=587
#    MAIL_USERNAME=bookings@wanderersouthindia.com
#    MAIL_PASSWORD=YourStrongPasswordHere
#    MAIL_ENCRYPTION=tls
#
# 3. Google Workspace / Gmail (Requires App Password, not account password):
#    MAIL_HOST=smtp.gmail.com
#    MAIL_PORT=587
#    MAIL_USERNAME=your-account@gmail.com
#    MAIL_PASSWORD=your-16-char-app-password
#    MAIL_ENCRYPTION=tls
#
# 4. Brevo (formerly Sendinblue) SMTP:
#    MAIL_HOST=smtp-relay.brevo.com
#    MAIL_PORT=587
#    MAIL_USERNAME=your-brevo-login-email
#    MAIL_PASSWORD=your-brevo-smtp-key
#    MAIL_ENCRYPTION=tls
# ------------------------------------------------------------------------------
