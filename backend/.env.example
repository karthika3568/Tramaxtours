# ==============================================================================
# Tramax Tours - Backend Environment Configuration Example
# Copy this file to .env and customize with your local environment values
# ==============================================================================

# Application Settings
APP_NAME=TramaxTours
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tramaxtours
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JSON Web Token (JWT) Configuration
JWT_SECRET=YOUR_SECURE_RANDOM_64_CHAR_SECRET_KEY_HERE
JWT_EXPIRATION=86400
JWT_ISSUER=TramaxToursAPI

# Media Library & File Upload Configuration (in bytes, 10485760 = 10MB)
MEDIA_MAX_FILE_SIZE=10485760

# Super Admin Account Configuration
# (Change email or password here anytime, and it will automatically update in the database on login)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@tramaxtours.com
ADMIN_PASSWORD=Admin@12345

